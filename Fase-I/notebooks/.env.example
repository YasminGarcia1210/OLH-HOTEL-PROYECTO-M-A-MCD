# Copiar a .env en esta carpeta (notebooks/) y rellenar.
# El archivo .env no debe committearse (ver .gitignore en la raíz del repo).
#
# Uso con Jupyter/VS Code: el notebook embeddings_umap_validacion intenta
# load_dotenv() si instalaste:  pip install python-dotenv
# Si no, exportá las variables en la terminal antes de abrir Jupyter.

# --- Neon / PostgreSQL (una basta) ---
# Connection string del panel de Neon (incluir sslmode=require si no viene en la URL).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Opcional: misma URL con otro nombre si preferís no chocar con otros servicios
# NEON_DATABASE_URL=
