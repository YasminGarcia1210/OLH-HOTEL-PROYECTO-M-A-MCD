# Copiá a .env local (no commitear). En ACA usá secretos / variables del recurso.
# n8n — URL pública (sustituí tras crear la Container App)
N8N_HOST=n8n-olh-pipeline.eastus2.azurecontainerapps.io
N8N_PROTOCOL=https
N8N_PORT=5678
WEBHOOK_URL=https://n8n-olh-pipeline.eastus2.azurecontainerapps.io/

# Cifrado de credenciales en n8n (obligatorio en producción; generá: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=

# Azure Files / SMB: permisos 0777 en /home/node/.n8n; en ACA conviene false (ver docs/DEPLOY_AZURE_ACA.md §2.2)
# N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false

# --- URLs de servicios del pipeline (HTTP Request del workflow miaa-Olh-hoteles-icesi) ---
SVC_DATA_VERIFICATION_URL_EJECUTAR=https://data-verification-cleaner.nicehill-77407515.eastus2.azurecontainerapps.io/api/v1/verificacion/ejecutar
SVC_SENTIMENT_URL_PROCESAR=https://sentiment-prediction.nicehill-77407515.eastus2.azurecontainerapps.io/api/v1/sentimiento/procesar
# Base hasta /sentimiento (sin /archivo/...); el workflow concatena /archivo/{id}/resultados
SVC_SENTIMENT_API_BASE=https://sentiment-prediction.nicehill-77407515.eastus2.azurecontainerapps.io/api/v1/sentimiento
SVC_ABSA_URL_PROCESAR_BATCH=https://absa-service.nicehill-77407515.eastus2.azurecontainerapps.io/api/v1/absa/procesar-batch
SVC_ABSA_URL_BATCH_SINCRONIZAR=https://absa-service.nicehill-77407515.eastus2.azurecontainerapps.io/api/v1/absa/batch/sincronizar
SVC_METRIC_PROCESSOR_URL_CALCULAR=https://metric-processor.nicehill-77407515.eastus2.azurecontainerapps.io/api/v1/metricas/calcular

# Destinatarios de alertas Gmail (coma, sin espacios recomendado)
OLH_PIPELINE_NOTIFY_RECIPIENTS=rchicangana@gmail.com,lauraichaparro11@gmail.com,fabianortiz.iet@gmail.com

# Obligatorio para el workflow miaa-Olh-hoteles-icesi ($env.SVC_*). Si es true, "access to env vars denied"
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# --- Opcional: PostgreSQL para n8n (misma BD Neon que las APIs: mismo DB_POSTGRESDB_DATABASE, schema aparte) ---
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=olh_sentiment
# DB_POSTGRESDB_SCHEMA=n8n
# DB_POSTGRESDB_SSL_ENABLED=true
# DB_POSTGRESDB_USER=
# DB_POSTGRESDB_PASSWORD=
