# Copiar a .env y ajustar valores locales.
SECRET_KEY=cambiar-en-produccion
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5003

# PostgreSQL (mismo esquema que el resto del pipeline; ver guidelines/ddl_bd.sql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=olh_sentiment
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=require
DB_POOL_MIN=1
DB_POOL_MAX=10

# Modelo: carpeta local (p91) o repositorio público del Hub, p. ej.:
SENTIMENT_MODEL_DIR=rchicangana/robertuito-holel-reviews-sentiment-analysis
# SENTIMENT_MODEL_DIR=   # opcional; por defecto models/p91 relativo al servicio
SENTIMENT_MODEL_VERSION=p93
SENTIMENT_BATCH_SIZE=8
# cpu o cuda
SENTIMENT_DEVICE=cpu
# Opcional: límite de caracteres para POST /api/v1/sentimiento/predecir
# SENTIMENT_MAX_INPUT_CHARS=8000
