# Puerto en el que escucha el servicio
PORT=5004

# Entorno de ejecución
FLASK_ENV=development
FLASK_DEBUG=true

# Clave secreta de Flask (cambiar en producción)
SECRET_KEY=dev-secret-key

# ── Base de datos PostgreSQL ──────────────────────────────────
# Host y puerto de la instancia (Neon u otro proveedor)
DB_HOST=<host>.neon.tech
DB_PORT=5432
DB_NAME=olh_sentiment
DB_USER=<usuario>
DB_PASSWORD=<contraseña>
DB_SSLMODE=require

# Tamaño del pool de conexiones
DB_POOL_MIN=1
DB_POOL_MAX=10

# ── Suavizado bayesiano del score (positivo vs no positivo) ─────────
# score = ((positivas + C*m) / (total + C)) * 100  (ver guidelines/calculo-metricas.md)
LAPLACE_PRIOR_M=0.6
LAPLACE_PRIOR_C=5
