# ── Entorno ────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5001

# ── Seguridad ──────────────────────────────────────────────────
SECRET_KEY=cambia-esta-clave-en-produccion

# ── Base de datos (PostgreSQL) ─────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=olh_sentiment
DB_USER=postgres
DB_PASSWORD=

# Pool de conexiones (psycopg2 ThreadedConnectionPool)
DB_POOL_MIN=1    # conexiones mínimas en reposo
DB_POOL_MAX=10   # conexiones máximas simultáneas

# ── Azure Blob Storage ────────────────────────────────────────
# Cadena de conexión del Storage Account (Portal Azure → Claves de acceso).
AZURE_STORAGE_CONNECTION_STRING=BlobEndpoint=

# Nombre del contenedor donde viven los blobs (CSV entrantes, limpios, procesados).
AZURE_STORAGE_CONTAINER=

# Prefijos virtuales (sin barra inicial; se normaliza con / al final).
# Donde se sube el CSV limpio tras la limpieza.
AZURE_BLOB_PREFIX_LIMPIOS=limpios

# Donde se mueve el CSV original tras procesarlo (copia + borrado en origen).
AZURE_BLOB_PREFIX_PROCESADOS=procesados
