# Copiar a .env y rellenar valores reales.
# cp .env.example .env
#
# Índice (grep en este archivo): ABSA_MODEL_BACKEND, OPENAI_BATCH_POLL_ENABLED,
#   OPENAI_BATCH_POLL_INTERVAL_SEC, LLM_PROVIDER, OPENAI_API_KEY, DATABASE_URL

# ── Flask ───────────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-key
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5003

# ── PostgreSQL (cadena completa, p. ej. Neon) ───────────────────────────────
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_bd

DB_POOL_MIN=1
DB_POOL_MAX=10

# ── ABSA ────────────────────────────────────────────────────────────────────
# ABSA_MODEL_BACKEND — valores: llm | deberta
ABSA_MODEL_BACKEND=llm

# LLM_PROVIDER — valores: openai | gemini | ollama
LLM_PROVIDER=ollama

# OpenAI (OPENAI_API_KEY obligatorio si LLM_PROVIDER=openai; POST /procesar-batch usa Batch API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OPENAI_BATCH_POLL_ENABLED — true | false (solo efecto con ABSA_MODEL_BACKEND=llm y LLM_PROVIDER=openai)
OPENAI_BATCH_POLL_ENABLED=false
# OPENAI_BATCH_POLL_INTERVAL_SEC — segundos entre cada POST interno /batch/sincronizar en el poller (mín. 10 en código)
OPENAI_BATCH_POLL_INTERVAL_SEC=120

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Backend deberta (ABSA_MODEL_BACKEND=deberta) ────────────────────────────
SENTENCE_MODEL=paraphrase-multilingual-MiniLM-L12-v2
BERTOPIC_MIN_TOPIC_SIZE=3
BERTOPIC_MIN_DYNAMIC_SCORE=0.65
BERTOPIC_MAX_DYNAMIC_PER_REVIEW=2
NLI_MAX_FIXED_PER_REVIEW=3
DEBERTA_ABSA_MODEL=yangheng/deberta-v3-base-absa-v1.1
NLI_MODEL=cross-encoder/nli-deberta-v3-small
NLI_ENTAILMENT_THRESHOLD=0.5
