# Copiar a .env y ajustar según entorno local
SECRET_KEY=cambiar-en-produccion
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5002

# Base de datos PostgreSQL (Neon u otro proveedor)
DB_HOST=
DB_PORT=5432
DB_NAME=olh_sentiment
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require

# Pool de conexiones
DB_POOL_MIN=1
DB_POOL_MAX=10

# Azure Blob Storage (subida POST /api/v1/metricas/archivos/upload)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
# Prefijo virtual dentro del contenedor (p. ej. entrada o dashboard/uploads).
# Vacío o solo "/" = listar desde la raíz del contenedor (GET /metricas/archivos/entrada
# incluye todos los blobs; la subida POST deja el archivo en la raíz si también está vacío).
AZURE_BLOB_PREFIX_UPLOAD=
# Opcional: carpetas virtuales a NO listar en GET .../archivos/entrada (coma). Por defecto en código: limpios.
# Para desactivar exclusiones: AZURE_BLOB_LIST_EXCLUDE_PREFIXES=
# AZURE_BLOB_LIST_EXCLUDE_PREFIXES=limpios,backup

# Tamaño máximo del archivo en bytes (default 52428800 = 50 MiB)
UPLOAD_MAX_BYTES=52428800

JWT_SECRET_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXX
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=30

# MetricProcessor — POST /api/v1/metricas/recalcular-semestre llama a este servicio
# Timeout por cada mes (6 meses ⇒ hasta 6× este valor en el peor caso).
METRIC_PROCESSOR_URL=http://localhost:5004
METRIC_PROCESSOR_TIMEOUT_SECONDS=60