# Usar con contexto `sources/app/olh-sentiment-ia` y:
#   podman build --ignorefile sources/app/olh-sentiment-ia/context.dockerignore ...
# Sin esto, se empaqueta la build local `.next/`, `node_modules/`, etc. y en
# Windows + Podman Machine la transferencia del tar puede tardar minutos sin
# imprimir nada en consola.

# Salidas de build / dependencias instaladas localmente
node_modules
.next
out
build
.vercel

# Caches y artefactos de TypeScript
*.tsbuildinfo
next-env.d.ts

# Entornos locales y secretos (nunca dentro de la imagen)
.env
.env.*
!.env.example

# Ruido del repo / IDE / git
.git
.gitignore
.cursor
.vscode
.idea
**/.DS_Store

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Carpetas que no deben formar parte del contexto
coverage
docs
stitch
cursor
